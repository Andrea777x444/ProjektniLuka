<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ba.etf.luka.user.controller.SimulacijaStartKontroler"
      spacing="18" styleClass="forma-container"
      alignment="CENTER">
    <padding><Insets top="30" left="40" right="40" bottom="30"/></padding>

    <Label text="Pokretanje simulacije" styleClass="naslov"
           style="-fx-text-fill: #1e3a5f;"/>

    <GridPane hgap="14" vgap="12" alignment="CENTER">
        <Label text="Min. plovila po terminalu:"
               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Spinner fx:id="spMinPlovila" min="1" max="50" initialValue="5"
                 editable="true" prefWidth="100"
                 GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Plovila koja napuštaju luku (%):"
               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label text="15% (automatski)" style="-fx-text-fill: #6b7280;"
               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <Separator/>

    <Label text="Napomena: 90% plovila su komercijalna, 10% državna."
           style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>

    <HBox spacing="12" alignment="CENTER">
        <Button text="Odustani" onAction="#onOdustani"
                styleClass="btn-secondary"/>
        <Button text="▶ Pokreni simulaciju" onAction="#onPokreni"
                styleClass="btn-success"/>
    </HBox>
</VBox>